{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "EOM-05 App upload. The app is the front door; this flow writes the library and the lists. The Power Apps Attachments control is deliberately not used.",
  "parameters": {
    "$connections": { "defaultValue": {}, "type": "Object" },
    "$authentication": { "defaultValue": {}, "type": "SecureObject" }
  },
  "triggers": {
    "When_Power_Apps_calls": {
      "type": "Request",
      "kind": "PowerApp",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "correlationId": { "type": "string" },
            "eomItemId": { "type": "string" },
            "eomItemKey": { "type": "string" },
            "facilityId": { "type": "string" },
            "installationId": { "type": "string" },
            "requirementId": { "type": "string" },
            "periodId": { "type": "string" },
            "fileName": { "type": "string" },
            "fileContent": { "type": "string" },
            "submittedBy": { "type": "string" },
            "channel": { "type": "string" },
            "classificationMethod": { "type": "string" },
            "appVersion": { "type": "string" }
          },
          "required": ["eomItemId", "fileName", "fileContent", "submittedBy"]
        }
      }
    }
  },
  "actions": {
    "Get_config": {
      "type": "ApiConnection",
      "runAfter": {},
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_App_Config'))}/items",
        "queries": { "$filter": "Is_Active eq 1" }
      }
    },
    "Compose_config": {
      "type": "Compose",
      "runAfter": { "Get_config": ["Succeeded"] },
      "inputs": "@json(concat('{', join(select(body('Get_config')?['value'], concat('\"', item()?['Title'], '\":\"', item()?['Config_Value'], '\"')), ','), '}'))"
    },
    "Reject_if_read_only": {
      "type": "If",
      "runAfter": { "Compose_config": ["Succeeded"] },
      "expression": { "equals": ["@toLower(string(outputs('Compose_config')?['ReadOnlyMode']))", "true"] },
      "metadata": { "comment": "The disabled button in the app is a courtesy. This is the control." },
      "actions": {
        "Respond_read_only": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "ok": false,
              "code": "READ_ONLY",
              "message": "Read-only mode is on, so submissions are paused. Your file has not been saved. Try again once the pause is lifted.",
              "versionNumber": 0,
              "submissionId": ""
            }
          }
        },
        "Terminate_read_only": { "type": "Terminate", "runAfter": { "Respond_read_only": ["Succeeded"] }, "inputs": { "runStatus": "Succeeded" } }
      },
      "else": { "actions": {} }
    },
    "Get_item": {
      "type": "ApiConnection",
      "runAfter": { "Reject_if_read_only": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_EOM_Item'))}/items",
        "queries": { "$filter": "EOM_Item_ID eq '@{triggerBody()['eomItemId']}'", "$top": 1 }
      },
      "metadata": { "comment": "Never invent a requirement. If this returns nothing, the upload is refused; it does not create a tracker row." }
    },
    "Reject_if_no_item": {
      "type": "If",
      "runAfter": { "Get_item": ["Succeeded"] },
      "expression": { "equals": ["@length(body('Get_item')?['value'])", 0] },
      "actions": {
        "Respond_no_item": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "ok": false,
              "code": "NO_SUCH_ITEM",
              "message": "No expected item matches this facility, document type and period. The file has not been saved. If this document is genuinely required, ask a portfolio manager to add the requirement.",
              "versionNumber": 0,
              "submissionId": ""
            }
          }
        },
        "Terminate_no_item": { "type": "Terminate", "runAfter": { "Respond_no_item": ["Succeeded"] }, "inputs": { "runStatus": "Succeeded" } }
      },
      "else": { "actions": {} }
    },
    "Check_caller_scope": {
      "type": "ApiConnection",
      "runAfter": { "Reject_if_no_item": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_Security_Mapping'))}/items",
        "queries": { "$filter": "Is_Active eq 1 and Principal_UPN eq '@{triggerBody()['submittedBy']}'" }
      },
      "metadata": { "comment": "The app only offers facilities the user is mapped to. A flow invoked directly would not be so polite, so the mapping is re-checked here." }
    },
    "Get_current_version": {
      "type": "ApiConnection",
      "runAfter": { "Check_caller_scope": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_EOM_Submission'))}/items",
        "queries": { "$filter": "EOM_Item_ID eq '@{triggerBody()['eomItemId']}' and Is_Current_Version eq 1", "$top": 1 }
      }
    },
    "Compose_next_version": {
      "type": "Compose",
      "runAfter": { "Get_current_version": ["Succeeded"] },
      "inputs": "@add(if(equals(length(body('Get_current_version')?['value']),0), 0, int(first(body('Get_current_version')?['value'])?['Version_Number'])), 1)"
    },
    "Create_file": {
      "type": "ApiConnection",
      "runAfter": { "Compose_next_version": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "post",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/files",
        "queries": {
          "folderPath": "@{concat(outputs('Compose_config')?['EvidenceLibraryPath'], '/', first(body('Get_item')?['value'])?['Portfolio_ID'], '/FY', first(body('Get_item')?['value'])?['Fiscal_Year'], '/', first(body('Get_item')?['value'])?['Installation_ID'], '/', coalesce(first(body('Get_item')?['value'])?['Facility_ID'], first(body('Get_item')?['value'])?['Requirement_Scope']?['Value']), '/', triggerBody()['periodId'])}",
          "name": "@{concat(triggerBody()['eomItemKey'], '__v', string(outputs('Compose_next_version')), '__', triggerBody()['fileName'])}"
        },
        "body": "@base64ToBinary(triggerBody()['fileContent'])"
      },
      "metadata": { "comment": "Never overwrite. The version is in the name so a human browsing the library can orient, but the list row is truth and SharePoint_File_ID is what the app re-resolves links from." }
    },
    "Demote_previous_version": {
      "type": "If",
      "runAfter": { "Create_file": ["Succeeded"] },
      "expression": { "greater": ["@length(body('Get_current_version')?['value'])", 0] },
      "actions": {
        "Patch_previous": {
          "type": "ApiConnection",
          "inputs": {
            "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
            "method": "patch",
            "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_EOM_Submission'))}/items/@{first(body('Get_current_version')?['value'])?['ID']}",
            "body": { "Is_Current_Version": false }
          },
          "metadata": { "comment": "Demoted, not deleted. v1 keeps its row, its file and its QC history. Exactly one row per item carries Is_Current_Version = true." }
        }
      },
      "else": { "actions": {} }
    },
    "Create_submission": {
      "type": "ApiConnection",
      "runAfter": { "Demote_previous_version": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "post",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_EOM_Submission'))}/items",
        "body": {
          "Title": "@{concat(triggerBody()['eomItemKey'], '|v', string(outputs('Compose_next_version')))}",
          "Submission_ID": "@{guid()}",
          "EOM_Item_ID": "@{triggerBody()['eomItemId']}",
          "Version_Number": "@{outputs('Compose_next_version')}",
          "Is_Current_Version": true,
          "File_Name": "@{triggerBody()['fileName']}",
          "SharePoint_File_ID": "@{body('Create_file')?['Id']}",
          "SharePoint_File_Url": "@{body('Create_file')?['Path']}",
          "File_Size_Bytes": "@{body('Create_file')?['Size']}",
          "Submitted_By_UPN": "@{triggerBody()['submittedBy']}",
          "Submitted_On": "@{utcNow()}",
          "Submission_Channel": { "Value": "APP_UPLOAD" },
          "Classification_Method": { "Value": "DECLARED" },
          "Classification_Status": { "Value": "CLASSIFIED" },
          "Classification_Confidence": 100,
          "QC_Status": { "Value": "PENDING" }
        },
        "metadata": { "comment": "Classification_Method DECLARED, confidence 100: the user declared installation, facility, document type and period before choosing the file. The filename is evidence, never a classification method." }
      }
    },
    "Update_item_status": {
      "type": "ApiConnection",
      "runAfter": { "Create_submission": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "patch",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_EOM_Item'))}/items/@{first(body('Get_item')?['value'])?['ID']}",
        "body": {
          "Current_Submission_ID": "@{body('Create_submission')?['Submission_ID']}",
          "Current_Version_Number": "@{outputs('Compose_next_version')}",
          "Status_Code": { "Value": "SUBMITTED" },
          "Status_Semantic": "Submitted - awaiting review",
          "Final_Status": { "Value": "Amber" },
          "Action_Owner_Role": { "Value": "Reviewer" },
          "Action_Required": true
        }
      },
      "metadata": { "comment": "Step 7 of the engine: a current submission with QC_Status PENDING makes the item SUBMITTED. The four status fields are written together, from one evaluation. Nothing here chooses a colour." }
    },
    "Log_upload": {
      "type": "ApiConnection",
      "runAfter": { "Update_item_status": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" } },
        "method": "post",
        "path": "/datasets/@{encodeURIComponent(parameters('siteUrl'))}/tables/@{encodeURIComponent(parameters('listId_MF_App_Event_Log'))}/items",
        "body": {
          "Title": "@{concat(triggerBody()['correlationId'], '|Upload')}",
          "Event_Time": "@{utcNow()}",
          "Event_Type": { "Value": "Upload" },
          "Severity": { "Value": "Info" },
          "User_UPN": "@{triggerBody()['submittedBy']}",
          "App_Version": "@{triggerBody()['appVersion']}",
          "Screen_Name": "EOM05-AppUpload",
          "Correlation_ID": "@{triggerBody()['correlationId']}",
          "Entity_ID": "@{triggerBody()['eomItemId']}",
          "Detail_Json": "@{concat('{\"version\":', string(outputs('Compose_next_version')), ',\"channel\":\"APP_UPLOAD\",\"method\":\"DECLARED\"}')}"
        }
      }
    },
    "Respond_ok": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": { "Log_upload": ["Succeeded", "Failed", "Skipped"] },
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true,
          "code": "OK",
          "message": "",
          "versionNumber": "@{outputs('Compose_next_version')}",
          "submissionId": "@{body('Create_submission')?['Submission_ID']}"
        }
      }
    }
  }
}
