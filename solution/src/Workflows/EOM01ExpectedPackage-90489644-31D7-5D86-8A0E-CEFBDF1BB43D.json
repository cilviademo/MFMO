              "$filter": "Active_Flag eq 1",
              "$top": 500
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "4777fa49-5491-503d-aa88-0ae006fe96e1"
          }
        },
        "Get_onboarded_installations": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Get_active_requirements": [
