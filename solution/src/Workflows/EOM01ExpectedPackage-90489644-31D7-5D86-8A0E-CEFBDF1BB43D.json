        "For_each_requirement": {
          "type": "Foreach",
          "foreach": "@body('Get_active_requirements')?['value']",
          "actions": {
            "Does_the_frequency_fall_in_this_period": {
              "type": "If",
              "expression": {
                "or": [
                  {
                    "and": [
                      {
                        "equals": [
                          "@items('For_each_requirement')?['Frequency']",
                          "Monthly"
                        ]
                      }
                    ]
                  },
                  {
                    "and": [
                      {
                        "equals": [
                          "@items('For_each_requirement')?['Frequency']",
                          "Quarterly"
                        ]
                      },
                      {
                        "contains": [
                          "@createArray(12, 3, 6, 9)",
                          "@int(split(variables('Period'), '-')[1])"
                        ]
                      }
                    ]
                  },
                  {
                    "and": [
                      {
                        "equals": [
                          "@items('For_each_requirement')?['Frequency']",
                          "Semiannual"
                        ]
                      },
                      {
                        "contains": [
                          "@createArray(3, 9)",
                          "@int(split(variables('Period'), '-')[1])"
                        ]
                      }
                    ]
                  },
                  {
                    "and": [
                      {
                        "equals": [
                          "@items('For_each_requirement')?['Frequency']",
                          "Annual"
                        ]
                      },
                      {
                        "equals": [
                          "@int(split(variables('Period'), '-')[1])",
                          "@int(coalesce(items('For_each_requirement')?['Applicable_Period_Month'], '9'))"
                        ]
                      }
                    ]
                  }
                ]
              },
              "actions": {
                "Applicable_facilities": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@filter(body('Get_active_facilities')?['value'], and(not(empty(trim(coalesce(item()?['Operating_Model'], '')))), or(equals(items('For_each_requirement')?['Applicable_Model'], 'All'), equals(item()?['Operating_Model'], items('For_each_requirement')?['Applicable_Model'])), or(empty(trim(coalesce(items('For_each_requirement')?['Applicable_Facility_Types'], ''))), empty(trim(coalesce(item()?['Facility_Type'], ''))), contains(concat(';', items('For_each_requirement')?['Applicable_Facility_Types'], ';'), concat(';', item()?['Facility_Type'], ';')))))",
                  "metadata": {
                    "operationMetadataId": "88d47145-a2cb-59be-a90e-a1ea0e56b7aa"
                  }
                },
                "Count_the_match": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Applicable_facilities": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "Matched",
                    "value": "@add(variables('Matched'), length(outputs('Applicable_facilities')))"
                  },
                  "metadata": {
                    "operationMetadataId": "67ea993a-b2d1-5307-8490-450e061469d5"
                  }
                },
                "For_each_facility": {
                  "type": "Foreach",
                  "foreach": "@outputs('Applicable_facilities')",
                  "actions": {
                    "EOM_Item_ID": {
                      "type": "Compose",
                      "runAfter": {},
                      "inputs": "@{concat(variables('Period'), '|', items('For_each_facility')?['Facility_ID'], '|', items('For_each_requirement')?['Requirement_ID'])}",
                      "metadata": {
                        "operationMetadataId": "1f2f95e1-4a66-5876-8fb9-1a601686ea1d"
                      }
                    },
                    "Does_it_already_exist": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "EOM_Item_ID": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "GetItems",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
                          "table": "@parameters('MF_ItemList (mfops_MF_ItemList)')",
                          "$filter": "EOM_Item_ID eq '@{outputs('EOM_Item_ID')}'",
                          "$top": 1
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "metadata": {
                        "operationMetadataId": "c2b1e14e-5436-5ecf-9237-5212b5a1203e"
                      }
                    },
                    "Create_only_if_absent": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@length(body('Does_it_already_exist')?['value'])",
                          0
                        ]
                      },
                      "actions": {
                        "Nominal_dates": {
                          "type": "Compose",
                          "runAfter": {},
                          "inputs": {
                            "nominalDue": "@{formatDateTime(addToTime(addToTime(startOfMonth(addToTime(concat(variables('Period'), '-01T00:00:00Z'), 1, 'Month')), 0, 'Day'), sub(int(items('For_each_requirement')?['Due_Day']), 1), 'Day'), 'yyyy-MM-dd')}",
                            "nominalFinal": "@{formatDateTime(addToTime(addToTime(startOfMonth(addToTime(concat(variables('Period'), '-01T00:00:00Z'), 1, 'Month')), 0, 'Day'), sub(int(coalesce(items('For_each_requirement')?['Final_Due_Day'], items('For_each_requirement')?['Due_Day'])), 1), 'Day'), 'yyyy-MM-dd')}"
                          },
                          "metadata": {
                            "operationMetadataId": "713aa875-6eca-5166-ae83-24749b845517"
                          }
                        },
                        "Get_non_duty_days": {
                          "type": "OpenApiConnection",
                          "runAfter": {
                            "Nominal_dates": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "GetItems",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
                              "table": "@parameters('MF_NonDutyDayList (mfops_MF_NonDutyDayList)')",
                              "$filter": "Active_Flag eq 1",
                              "$top": 2000
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "metadata": {
                            "operationMetadataId": "577f70d5-2c0a-58bf-9017-39cabfb3033a"
                          }
                        },
                        "Effective_dates": {
                          "type": "Compose",
                          "runAfter": {
                            "Get_non_duty_days": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "effectiveDue": "@{outputs('Nominal_dates')['nominalDue']}",
                            "effectiveFinal": "@{outputs('Nominal_dates')['nominalFinal']}",
                            "policy": "NEXT_DUTY_DAY",
                            "adjusted": "@not(equals(outputs('Nominal_dates')['nominalDue'], outputs('Nominal_dates')['nominalDue']))",
                            "TODO_ROLL": "Roll each date forward past any Active MF Non Duty Day row whose Scope_Type is Enterprise or whose Scope_ID matches this installation, and past Saturday and Sunday, for at most 14 days. scripts/status_engine.effective_date is the reference and raises beyond 14."
                          },
                          "metadata": {
                            "operationMetadataId": "10d44fee-6789-5d96-a3ed-6e8d95b2eb53"
                          }
                        },
                        "Today": {
                          "type": "InitializeVariable",
                          "runAfter": {
                            "Effective_dates": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "variables": [
                              {
                                "name": "Today",
                                "type": "string",
                                "value": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
                              }
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "7d617c5c-db20-5033-8696-3556692ff6b9"
                          }
                        },
                        "EffectiveDueDate": {
                          "type": "InitializeVariable",
                          "runAfter": {
                            "Today": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "variables": [
                              {
                                "name": "EffectiveDueDate",
                                "type": "string",
                                "value": "@{outputs('Effective_dates')['effectiveDue']}"
                              }
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "6ad5f5d5-8003-548b-a622-4bc8d532a20f"
                          }
                        },
                        "EffectiveFinalCallDate": {
                          "type": "InitializeVariable",
                          "runAfter": {
                            "EffectiveDueDate": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "variables": [
                              {
                                "name": "EffectiveFinalCallDate",
                                "type": "string",
                                "value": "@{outputs('Effective_dates')['effectiveFinal']}"
                              }
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "14c62c26-b063-50a8-95a5-6544634e4c53"
                          }
                        },
                        "RequiredFlag": {
                          "type": "InitializeVariable",
                          "runAfter": {
                            "EffectiveFinalCallDate": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "variables": [
                              {
                                "name": "RequiredFlag",
                                "type": "boolean",
                                "value": "@equals(items('For_each_requirement')?['Required_Flag'], true)"
                              }
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "8357f4e1-6817-53f4-bb2a-ff5a715ee178"
                          }
                        },
                        "WaivedFlag": {
                          "type": "InitializeVariable",
                          "runAfter": {
                            "RequiredFlag": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "variables": [
                              {
                                "name": "WaivedFlag",
                                "type": "boolean",
                                "value": false
                              }
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "0629f6fc-7254-52cf-901d-db8490402b3d"
                          }
                        },
