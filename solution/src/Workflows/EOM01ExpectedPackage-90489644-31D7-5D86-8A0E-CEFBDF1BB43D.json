              "$filter": "Active_Flag eq 1",
              "$top": 2000
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "df9bea80-7b02-5d70-b561-7ba7cf4d98c3"
          }
        },
        "Assert_the_registry_is_not_empty": {
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@length(body('Get_onboarded_installations')?['value'])",
                  0
                ]
              },
              {
                "equals": [
                  "@length(body('Get_active_facilities')?['value'])",
                  0
                ]
              },
              {
                "equals": [
                  "@length(body('Get_active_requirements')?['value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
