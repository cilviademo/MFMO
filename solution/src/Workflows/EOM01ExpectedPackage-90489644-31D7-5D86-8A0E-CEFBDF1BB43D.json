          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
              "table": "@parameters('MF_InstallationList (mfops_MF_InstallationList)')",
              "$filter": "Active_Flag eq 1 and Generation_Enabled eq 1",
              "$top": 500
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "aee73dec-91b6-5b4b-9ce6-b435e11cf20c"
          }
        },
        "Get_active_facilities": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Get_onboarded_installations": [
