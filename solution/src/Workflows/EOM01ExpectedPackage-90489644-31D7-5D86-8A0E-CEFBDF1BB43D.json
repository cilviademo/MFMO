          "metadata": {
            "operationMetadataId": "c6e0f532-bf38-503a-ad64-6b8f2134c782"
          }
        },
        "Get_the_deployed_schema_version": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Initialize_ExpectedSchemaVersion": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
              "table": "@parameters('MF_ConfigList (mfops_MF_ConfigList)')",
              "$filter": "Config_Key eq 'SchemaVersion'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "2179055b-06fb-54a1-81f3-ad6b6a773161"
          }
        },
        "Stop_on_a_schema_mismatch": {
          "type": "If",
          "runAfter": {
            "Get_the_deployed_schema_version": [
              "Succeeded"
            ]
          },
          "expression": {
            "not": {
              "equals": [
                "@first(body('Get_the_deployed_schema_version')?['value'])?['Config_Value']",
                "@variables('ExpectedSchemaVersion')"
              ]
            }
          },
          "actions": {
            "CONFIGURATION_REQUIRED": {
              "type": "Terminate",
              "runAfter": {},
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CONFIGURATION_REQUIRED",
                  "message": "This flow expects a different schema version than MF_App_Config reports. A newer flow writing against an older schema patches columns that do not exist, which writes nothing rather than erroring. Stopped before any write. See docs/SHAREPOINT_SCHEMA_MANIFEST.md."
                }
              },
              "metadata": {
                "operationMetadataId": "07673d17-1783-5154-a663-0307ab8a4432"
              }
            }
          },
          "else": {
            "actions": {}
          },
          "metadata": {
            "operationMetadataId": "8e1439b4-bcc1-57ff-8996-475f6d4ab6a4"
          }
        },
        "Period": {
          "type": "InitializeVariable",
          "runAfter": {
            "Stop_on_a_schema_mismatch": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "Period",
                "type": "string",
                "value": "@{formatDateTime(addToTime(utcNow(), -1, 'Month'), 'yyyy-MM')}"
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "4c603e00-3823-597d-9248-4afe271f128c"
          }
        },
        "Get_the_backfill_window": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Period": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
              "table": "@parameters('MF_ConfigList (mfops_MF_ConfigList)')",
              "$filter": "startswith(Config_Key,'Backfill') and Active_Flag eq 1"
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "7699ad6f-e26a-5c46-bb43-391ff4fe9687"
          }
        },
        "Window": {
          "type": "Compose",
          "runAfter": {
            "Get_the_backfill_window": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@{first(filter(body('Get_the_backfill_window')?['value'], item()?['Config_Key'] eq 'BackfillFromPeriod'))?['Config_Value']}",
            "to": "@{first(filter(body('Get_the_backfill_window')?['value'], item()?['Config_Key'] eq 'BackfillToPeriod'))?['Config_Value']}"
          },
          "metadata": {
            "operationMetadataId": "5c7695de-5196-55af-b9d5-2adbea22c86b"
          }
        },
        "Refuse_a_period_outside_the_window": {
          "type": "If",
          "expression": {
            "or": [
              {
                "less": [
                  "@variables('Period')",
                  "@outputs('Window')['from']"
                ]
              },
              {
                "greater": [
                  "@variables('Period')",
                  "@outputs('Window')['to']"
                ]
              }
            ]
          },
          "actions": {
            "PERIOD_OUTSIDE_BACKFILL_WINDOW": {
              "type": "Terminate",
              "runAfter": {},
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "PERIOD_OUTSIDE_BACKFILL_WINDOW",
                  "message": "@{concat(variables('Period'), ' is outside the configured backfill window ', outputs('Window')['from'], '..', outputs('Window')['to'], '. Widening it is a one-cell edit in MF App Config, and this flow is idempotent, so a later run against a wider range fills in the earlier periods without disturbing what already exists.')}"
                }
              },
              "metadata": {
                "operationMetadataId": "9a812f76-6ee2-5a7d-b3e5-f91ec823eb41"
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Window": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9d1c10a2-c184-5b59-8b7e-c5759025cfde"
          }
        },
        "Get_active_requirements": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Refuse_a_period_outside_the_window": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
