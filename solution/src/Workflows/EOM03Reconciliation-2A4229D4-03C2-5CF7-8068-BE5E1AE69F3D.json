            },
            "Status": {
              "type": "Compose",
              "runAfter": {
                "QCStatus": [
                  "Succeeded"
                ]
              },
              "inputs": "@{if(or(variables('WaivedFlag'), not(variables('RequiredFlag'))), json('{\"status\":\"NOT_APPLICABLE\",\"code\":0,\"actionOwner\":\"None\",\"actionRequired\":false}'), if(and(contains(createArray('UNVERIFIED','PROPOSED'), variables('AuthorityStatus')), not(variables('ReceivedFlag'))), json('{\"status\":\"PENDING_VALIDATION\",\"code\":4,\"actionOwner\":\"Admin\",\"actionRequired\":false}'), if(equals(variables('QCStatus'), 'Accepted'), json('{\"status\":\"ACCEPTED\",\"code\":3,\"actionOwner\":\"None\",\"actionRequired\":false}'), if(equals(variables('QCStatus'), 'Not Applicable'), json('{\"status\":\"NOT_APPLICABLE\",\"code\":0,\"actionOwner\":\"None\",\"actionRequired\":false}'), if(equals(variables('QCStatus'), 'Recalled'), if(if(empty(variables('EffectiveDueDate')), true, lessOrEquals(ticks(variables('Today')), ticks(variables('EffectiveDueDate')))), json('{\"status\":\"NOT_DUE\",\"code\":4,\"actionOwner\":\"Facility\",\"actionRequired\":false}'), if(if(empty(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))), true, lessOrEquals(ticks(variables('Today')), ticks(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))))), json('{\"status\":\"LATE\",\"code\":5,\"actionOwner\":\"Facility\",\"actionRequired\":true}'), json('{\"status\":\"OVERDUE\",\"code\":1,\"actionOwner\":\"Facility\",\"actionRequired\":true}'))), if(contains(createArray('Correction Required', 'Incomplete', 'Wrong Reporting Period', 'Wrong Facility'), variables('QCStatus')), json('{\"status\":\"RETURNED\",\"code\":1,\"actionOwner\":\"Facility\",\"actionRequired\":true}'), if(equals(variables('QCStatus'), 'Wrong Document'), if(if(empty(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))), false, greater(ticks(variables('Today')), ticks(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))))), json('{\"status\":\"OVERDUE\",\"code\":1,\"actionOwner\":\"Facility\",\"actionRequired\":true}'), json('{\"status\":\"NOT_SATISFIED\",\"code\":1,\"actionOwner\":\"Facility\",\"actionRequired\":true}')), if(variables('ReceivedFlag'), json('{\"status\":\"RECEIVED_PENDING_QC\",\"code\":2,\"actionOwner\":\"Reviewer\",\"actionRequired\":true}'), if(if(empty(variables('EffectiveDueDate')), true, lessOrEquals(ticks(variables('Today')), ticks(variables('EffectiveDueDate')))), json('{\"status\":\"NOT_DUE\",\"code\":4,\"actionOwner\":\"Facility\",\"actionRequired\":false}'), if(if(empty(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))), true, lessOrEquals(ticks(variables('Today')), ticks(if(empty(variables('EffectiveFinalCallDate')), variables('EffectiveDueDate'), variables('EffectiveFinalCallDate'))))), json('{\"status\":\"LATE\",\"code\":5,\"actionOwner\":\"Facility\",\"actionRequired\":true}'), json('{\"status\":\"OVERDUE\",\"code\":1,\"actionOwner\":\"Facility\",\"actionRequired\":true}')))))))))))}",
              "metadata": {
                "operationMetadataId": "f24770f4-70ff-543a-a4de-a672df9bb0dd"
              }
            },
            "Write_all_four_status_fields": {
