            ]
          },
          "inputs": "scripts/validate_solution.py --reconcile-fact compares EVERY row, not a sample. A fact table that agrees with the item list on 499 of 500 rows is a fact table nobody can trust.",
          "metadata": {
            "operationMetadataId": "e05e464e-775a-5a2c-a2c4-88f1c46d9faf"
