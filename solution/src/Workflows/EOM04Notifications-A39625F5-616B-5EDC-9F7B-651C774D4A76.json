{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mfops_sharepointonline"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mfops_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_SharePointSiteURL"
          }
        },
        "MF_ConfigList (mfops_MF_ConfigList)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_ConfigList"
          }
        },
        "MF_ItemList (mfops_MF_ItemList)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_ItemList"
          }
        },
        "MF_AuditList (mfops_MF_AuditList)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_AuditList"
          }
        },
        "MF_NotificationRuleList (mfops_MF_NotificationRuleList)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_NotificationRuleList"
          }
        },
        "MF_NotificationsEnabled (mfops_MF_NotificationsEnabled)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_NotificationsEnabled"
          }
        },
        "MF_EscalationDaysOverdue (mfops_MF_EscalationDaysOverdue)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "mfops_MF_EscalationDaysOverdue"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                0
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "c8e727ff-4772-58a8-806a-d95c5aae8481"
          }
        }
      },
      "actions": {
        "Initialize_ExpectedSchemaVersion": {
          "type": "InitializeVariable",
          "runAfter": {},
          "inputs": {
            "variables": [
              {
                "name": "ExpectedSchemaVersion",
                "type": "string",
                "value": "5.0"
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "f7ca0dd2-3245-57c2-a742-41a87c6869f6"
          }
        },
        "Get_the_deployed_schema_version": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Initialize_ExpectedSchemaVersion": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
              "table": "@parameters('MF_ConfigList (mfops_MF_ConfigList)')",
              "$filter": "Config_Key eq 'SchemaVersion'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "746dde5f-b1a6-558f-b5d8-cb2f2a341fdd"
          }
        },
        "Stop_on_a_schema_mismatch": {
          "type": "If",
          "runAfter": {
            "Get_the_deployed_schema_version": [
              "Succeeded"
            ]
          },
          "expression": {
            "not": {
              "equals": [
                "@first(body('Get_the_deployed_schema_version')?['value'])?['Config_Value']",
                "@variables('ExpectedSchemaVersion')"
              ]
            }
          },
          "actions": {
            "CONFIGURATION_REQUIRED": {
              "type": "Terminate",
              "runAfter": {},
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CONFIGURATION_REQUIRED",
                  "message": "This flow expects a different schema version than MF_App_Config reports. A newer flow writing against an older schema patches columns that do not exist, which writes nothing rather than erroring. Stopped before any write. See docs/SHAREPOINT_SCHEMA_MANIFEST.md."
                }
              },
              "metadata": {
                "operationMetadataId": "327f67fe-7d3b-55e2-a631-d9ade280d38f"
              }
            }
          },
          "else": {
            "actions": {}
          },
          "metadata": {
            "operationMetadataId": "309f296e-f5e5-53e6-92f6-6785276d63f1"
          }
        },
        "Today": {
          "type": "InitializeVariable",
          "runAfter": {
            "Stop_on_a_schema_mismatch": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "Today",
                "type": "string",
                "value": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "5ea64c2e-fc91-5d06-a26d-dd710c8da443"
          }
        },
        "Get_the_enabled_rules": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Today": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
              "table": "@parameters('MF_NotificationRuleList (mfops_MF_NotificationRuleList)')",
              "$filter": "Enabled eq 1",
              "$top": 100
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "a3b936aa-e069-5e28-85d4-c9ff17ad4793"
          }
        },
        "For_each_rule": {
          "type": "Foreach",
          "foreach": "@body('Get_the_enabled_rules')?['value']",
          "actions": {
            "Escalation_cutoff": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@{formatDateTime(addToTime(utcNow(), mul(-1, int(@parameters('MF_EscalationDaysOverdue (mfops_MF_EscalationDaysOverdue)'))), 'Day'), 'yyyy-MM-dd')}",
              "metadata": {
                "operationMetadataId": "ec83a848-416c-5eab-98ef-f8f7f26fec30"
              }
            },
            "Gather_the_recipients_work": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Escalation_cutoff": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
                  "table": "@parameters('MF_ItemList (mfops_MF_ItemList)')",
                  "$filter": "Action_Required eq 1 and Effective_Due_Date le '@{outputs('Escalation_cutoff')}'",
                  "$top": 2000
                },
                "authentication": "@parameters('$authentication')"
              },
              "metadata": {
                "operationMetadataId": "132212ae-dd01-5d69-98a6-375ef342ddfc"
              }
            },
            "Send_or_record_the_suppression": {
              "type": "If",
              "expression": {
                "equals": [
                  "@@parameters('MF_NotificationsEnabled (mfops_MF_NotificationsEnabled)')",
                  true
                ]
              },
              "actions": {
                "Send_the_digest": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage": {
                        "To": "@{items('For_each_rule')?['Recipient_Address']}",
                        "Subject": "@{items('For_each_rule')?['Subject_Template']}",
                        "Body": "<p>@{length(body('Gather_the_recipients_work')?['value'])} document(s) need your attention.</p>"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "metadata": {
                    "operationMetadataId": "ab78ba82-665f-5761-ab6b-c63c575e5dd0"
                  }
                }
              },
              "else": {
                "actions": {
                  "Record_what_it_would_have_sent": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PostItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('MF_SharePointSiteURL (mfops_MF_SharePointSiteURL)')",
                        "table": "@parameters('MF_AuditList (mfops_MF_AuditList)')",
                        "item": {
                          "Action": "Notification Suppressed",
                          "Action_DateTime": "@{utcNow()}",
                          "Entity_Type": "Notification",
                          "Entity_ID": "@{items('For_each_rule')?['Rule_ID']}",
                          "Detail": "@{concat('Would have notified ', items('For_each_rule')?['Recipient_Address'], ' about ', length(body('Gather_the_recipients_work')?['value']), ' item(s).')}"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "metadata": {
                      "operationMetadataId": "4723578d-160a-56f0-b5e6-b95cac71b6ad"
                    }
                  }
                }
              },
              "runAfter": {
                "Gather_the_recipients_work": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "4968581a-7ac9-58bc-906d-0c230df527ba"
              }
            }
          },
          "runAfter": {
            "Get_the_enabled_rules": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f62c4d73-4b06-52d5-b4b3-ad737b36e98b"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
