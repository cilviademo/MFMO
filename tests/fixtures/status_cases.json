{
  "_comment": "Status engine acceptance cases. Every branch of docs/status-calculation.md, in order, plus the traps. as_of is 2026-11-10 unless a case overrides it.",
  "as_of": "2026-11-10",
  "cases": [
    {
      "name": "requirement inactive",
      "input": { "suspense_date": "2026-11-05", "requirement_is_active": false },
      "expect": { "code": "NOT_APPLICABLE", "status": "Gray", "actionOwner": "None", "actionRequired": false, "is_complete": false, "is_in_denominator": false }
    },
    {
      "name": "requirement retired",
      "input": { "suspense_date": "2026-11-05", "requirement_verification_status": "RETIRED" },
      "expect": { "code": "NOT_APPLICABLE", "status": "Gray", "actionOwner": "None", "actionRequired": false }
    },
    {
      "name": "does not apply to this operating model",
      "input": { "suspense_date": "2026-11-05", "applies_to_facility": false },
      "expect": { "code": "NOT_APPLICABLE", "status": "Gray", "is_in_denominator": false }
    },
    {
      "name": "waived",
      "input": { "suspense_date": "2026-11-05", "waived": true, "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "WAIVED", "status": "Gray", "actionOwner": "None", "is_in_denominator": false }
    },
    {
      "name": "waived beats an accepted submission",
      "input": { "suspense_date": "2026-11-05", "waived": true, "has_current_submission": true, "qc_status": "ACCEPTED" },
      "expect": { "code": "WAIVED", "status": "Gray" }
    },
    {
      "name": "superseded",
      "input": { "suspense_date": "2026-11-05", "superseded": true },
      "expect": { "code": "SUPERSEDED", "status": "Gray", "is_in_denominator": false }
    },
    {
      "name": "accepted",
      "input": { "suspense_date": "2026-11-20", "has_current_submission": true, "qc_status": "ACCEPTED" },
      "expect": { "code": "ACCEPTED", "status": "Green", "actionOwner": "None", "actionRequired": false, "is_complete": true, "is_in_denominator": true }
    },
    {
      "name": "accepted after the suspense date is still Green",
      "input": { "suspense_date": "2026-11-01", "has_current_submission": true, "qc_status": "ACCEPTED", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "ACCEPTED", "status": "Green" }
    },
    {
      "name": "returned for correction",
      "input": { "suspense_date": "2026-11-20", "has_current_submission": true, "qc_status": "RETURNED" },
      "expect": { "code": "RETURNED", "status": "Amber", "actionOwner": "Facility", "actionRequired": true, "is_complete": false, "is_in_denominator": true }
    },
    {
      "name": "returned past suspense stays Amber and stays with the facility",
      "input": { "suspense_date": "2026-11-01", "has_current_submission": true, "qc_status": "RETURNED", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "RETURNED", "status": "Amber", "actionOwner": "Facility" }
    },
    {
      "name": "in review",
      "input": { "suspense_date": "2026-11-20", "has_current_submission": true, "qc_status": "IN_REVIEW" },
      "expect": { "code": "IN_REVIEW", "status": "Amber", "actionOwner": "Reviewer", "actionRequired": true }
    },
    {
      "name": "submitted awaiting review",
      "input": { "suspense_date": "2026-11-20", "has_current_submission": true, "qc_status": "PENDING" },
      "expect": { "code": "SUBMITTED", "status": "Amber", "actionOwner": "Reviewer", "actionRequired": true }
    },
    {
      "name": "submitted late is Amber with the reviewer, never Red",
      "input": { "suspense_date": "2026-11-01", "has_current_submission": true, "qc_status": "PENDING", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "SUBMITTED", "status": "Amber", "actionOwner": "Reviewer" }
    },
    {
      "name": "VERIFIED requirement past suspense with nothing submitted is Red",
      "input": { "suspense_date": "2026-11-05", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "OVERDUE", "status": "Red", "actionOwner": "Facility", "actionRequired": true, "is_complete": false, "is_in_denominator": true }
    },
    {
      "name": "UNVERIFIED requirement past suspense stays Gray and the action is the programme's",
      "input": { "suspense_date": "2026-11-05", "requirement_verification_status": "UNVERIFIED" },
      "expect": { "code": "PROVISIONAL_OVERDUE", "status": "Gray", "actionOwner": "Program", "actionRequired": true, "is_complete": false, "is_in_denominator": true }
    },
    {
      "name": "one day past suspense, verified",
      "input": { "suspense_date": "2026-11-09", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "OVERDUE", "status": "Red" }
    },
    {
      "name": "on the suspense date is not yet overdue",
      "input": { "suspense_date": "2026-11-10", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "DUE_SOON", "status": "Amber", "actionOwner": "Facility", "actionRequired": true }
    },
    {
      "name": "exactly at the edge of the due-soon window",
      "input": { "suspense_date": "2026-11-17", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "DUE_SOON", "status": "Amber" }
    },
    {
      "name": "one day outside the due-soon window",
      "input": { "suspense_date": "2026-11-18", "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "NOT_DUE", "status": "Blue", "actionRequired": false, "is_complete": false, "is_in_denominator": false }
    },
    {
      "name": "no suspense date at all",
      "input": { "suspense_date": null },
      "expect": { "code": "NOT_DUE", "status": "Blue" }
    },
    {
      "name": "a wider due-soon window moves the boundary",
      "input": { "suspense_date": "2026-11-25", "due_soon_window_days": 21, "requirement_verification_status": "VERIFIED" },
      "expect": { "code": "DUE_SOON", "status": "Amber" }
    }
  ],
  "rollups": [
    {
      "name": "a colour rollup would call this 33 percent; it is 100 percent",
      "codes": ["ACCEPTED", "NOT_DUE", "NOT_DUE"],
      "expect": { "in_denominator": 1, "complete": 1, "complete_ratio": 1.0 }
    },
    {
      "name": "waived and not applicable leave the denominator entirely",
      "codes": ["ACCEPTED", "WAIVED", "NOT_APPLICABLE", "SUPERSEDED"],
      "expect": { "in_denominator": 1, "complete": 1, "complete_ratio": 1.0 }
    },
    {
      "name": "nothing due is not zero percent and not one hundred percent",
      "codes": ["NOT_DUE", "NOT_DUE", "WAIVED"],
      "expect": { "in_denominator": 0, "complete": 0, "complete_ratio": null }
    },
    {
      "name": "a provisional overdue row counts against completeness",
      "codes": ["ACCEPTED", "PROVISIONAL_OVERDUE"],
      "expect": { "in_denominator": 2, "complete": 1, "complete_ratio": 0.5 }
    },
    {
      "name": "the realistic mid-month mix",
      "codes": ["ACCEPTED", "ACCEPTED", "SUBMITTED", "RETURNED", "OVERDUE", "NOT_DUE", "NOT_APPLICABLE"],
      "expect": { "in_denominator": 5, "complete": 2, "action_required": 3 }
    }
  ]
}
