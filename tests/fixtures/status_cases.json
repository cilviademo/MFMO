{
  "_comment": "Status engine acceptance cases. Every branch of the decision order in docs/status-calculation.md, in order, plus the traps. today is 2026-09-12 unless a case overrides it.",
  "today": "2026-09-12",
  "cases": [
    {
      "name": "1. waived",
      "input": { "due_date": "2026-09-10", "waived_flag": true, "authority_status": "Verified" },
      "expect": { "status": "NOT_APPLICABLE", "code": 0, "actionOwner": "None", "actionRequired": false }
    },
    {
      "name": "1. not required",
      "input": { "due_date": "2026-09-10", "required_flag": false, "authority_status": "Verified" },
      "expect": { "status": "NOT_APPLICABLE", "code": 0 }
    },
    {
      "name": "1. waived beats an accepted submission",
      "input": { "due_date": "2026-09-10", "waived_flag": true, "received_flag": true, "qc_status": "Accepted" },
      "expect": { "status": "NOT_APPLICABLE", "code": 0 }
    },
    {
      "name": "2. provisional and nothing received is Blue, owned by Admin, no action",
      "input": { "due_date": "2026-09-10", "authority_status": "UNVERIFIED" },
      "expect": { "status": "PENDING_VALIDATION", "code": 4, "actionOwner": "Admin", "actionRequired": false }
    },
    {
      "name": "2. provisional stays Blue however late it gets",
      "input": { "due_date": "2025-01-01", "authority_status": "UNVERIFIED" },
      "expect": { "status": "PENDING_VALIDATION", "code": 4 }
    },
    {
      "name": "2. provisional but received falls through to the QC rules",
      "input": { "due_date": "2026-09-10", "authority_status": "UNVERIFIED", "received_flag": true, "qc_status": "Pending Review" },
      "expect": { "status": "RECEIVED_PENDING_QC", "code": 2, "actionOwner": "Reviewer" }
    },
    {
      "name": "3. accepted",
      "input": { "due_date": "2026-09-30", "authority_status": "Verified", "received_flag": true, "qc_status": "Accepted" },
      "expect": { "status": "ACCEPTED", "code": 3, "actionOwner": "None", "actionRequired": false }
    },
    {
      "name": "3. accepted after the due date is still Green",
      "input": { "due_date": "2026-09-01", "authority_status": "Verified", "received_flag": true, "qc_status": "Accepted" },
      "expect": { "status": "ACCEPTED", "code": 3 }
    },
    {
      "name": "4. QC not applicable",
      "input": { "due_date": "2026-09-10", "authority_status": "Verified", "received_flag": true, "qc_status": "Not Applicable" },
      "expect": { "status": "NOT_APPLICABLE", "code": 0, "actionOwner": "None" }
    },
    {
      "name": "5. correction required",
      "input": { "due_date": "2026-09-30", "authority_status": "Verified", "received_flag": true, "qc_status": "Correction Required" },
      "expect": { "status": "CORRECTION_REQUIRED", "code": 2, "actionOwner": "Facility", "actionRequired": true }
    },
    {
      "name": "5. correction required past due stays Amber with the facility",
      "input": { "due_date": "2026-09-01", "authority_status": "Verified", "received_flag": true, "qc_status": "Correction Required" },
      "expect": { "status": "CORRECTION_REQUIRED", "code": 2, "actionOwner": "Facility" }
    },
    {
      "name": "6. wrong document past due is Red",
      "input": { "due_date": "2026-09-10", "authority_status": "Verified", "received_flag": true, "qc_status": "Wrong Document" },
      "expect": { "status": "OVERDUE", "code": 1, "actionOwner": "Facility", "actionRequired": true }
    },
    {
      "name": "7. wrong document before due is Amber, not Red",
      "input": { "due_date": "2026-09-30", "authority_status": "Verified", "received_flag": true, "qc_status": "Wrong Document" },
      "expect": { "status": "NOT_SATISFIED", "code": 2, "actionOwner": "Facility", "actionRequired": true }
    },
    {
      "name": "7. wrong document on the due date is not yet overdue",
      "input": { "due_date": "2026-09-12", "authority_status": "Verified", "received_flag": true, "qc_status": "Wrong Document" },
      "expect": { "status": "NOT_SATISFIED", "code": 2 }
    },
    {
      "name": "8. received awaiting review",
      "input": { "due_date": "2026-09-30", "authority_status": "Verified", "received_flag": true, "qc_status": "Pending Review" },
      "expect": { "status": "RECEIVED_PENDING_QC", "code": 2, "actionOwner": "Reviewer", "actionRequired": true }
    },
    {
      "name": "8. received late is Amber with the reviewer, never Red",
      "input": { "due_date": "2026-09-01", "authority_status": "Verified", "received_flag": true, "qc_status": "Pending Review" },
      "expect": { "status": "RECEIVED_PENDING_QC", "code": 2, "actionOwner": "Reviewer" }
    },
    {
      "name": "9. verified, nothing received, before due is Blue",
      "input": { "due_date": "2026-09-30", "authority_status": "Verified" },
      "expect": { "status": "NOT_DUE", "code": 4, "actionOwner": "Facility", "actionRequired": false }
    },
    {
      "name": "9. on the due date is not yet overdue",
      "input": { "due_date": "2026-09-12", "authority_status": "Verified" },
      "expect": { "status": "NOT_DUE", "code": 4 }
    },
    {
      "name": "10. verified, nothing received, past due is Red",
      "input": { "due_date": "2026-09-11", "authority_status": "Verified" },
      "expect": { "status": "OVERDUE", "code": 1, "actionOwner": "Facility", "actionRequired": true }
    },
    {
      "name": "no due date at all",
      "input": { "due_date": null, "authority_status": "Verified" },
      "expect": { "status": "NOT_DUE", "code": 4 }
    }
  ],
  "packages": [
    {
      "name": "the colour rollup would say Complete; it is In progress",
      "statuses": ["ACCEPTED", "NOT_DUE", "NOT_DUE"],
      "expect": { "state": "IN_PROGRESS", "code": 4 }
    },
    {
      "name": "everything applicable accepted",
      "statuses": ["ACCEPTED", "ACCEPTED", "NOT_APPLICABLE"],
      "expect": { "state": "COMPLETE", "code": 3 }
    },
    {
      "name": "nothing applicable",
      "statuses": ["NOT_APPLICABLE", "NOT_APPLICABLE"],
      "expect": { "state": "NOT_APPLICABLE", "code": 0 }
    },
    {
      "name": "one overdue beats everything",
      "statuses": ["ACCEPTED", "ACCEPTED", "OVERDUE", "RECEIVED_PENDING_QC"],
      "expect": { "state": "ACTION_REQUIRED", "code": 1 }
    },
    {
      "name": "not satisfied is action required, not in review",
      "statuses": ["ACCEPTED", "NOT_SATISFIED"],
      "expect": { "state": "ACTION_REQUIRED", "code": 1 }
    },
    {
      "name": "awaiting review with nothing adverse",
      "statuses": ["ACCEPTED", "RECEIVED_PENDING_QC"],
      "expect": { "state": "IN_REVIEW", "code": 2 }
    },
    {
      "name": "a provisional row neither completes nor blocks",
      "statuses": ["ACCEPTED", "PENDING_VALIDATION"],
      "expect": { "state": "COMPLETE", "code": 3 }
    },
    {
      "name": "provisional alone is in progress, not complete",
      "statuses": ["PENDING_VALIDATION", "PENDING_VALIDATION"],
      "expect": { "state": "IN_PROGRESS", "code": 4 }
    },
    {
      "name": "the realistic mid-month mix",
      "statuses": ["ACCEPTED", "ACCEPTED", "RECEIVED_PENDING_QC", "NOT_DUE", "PENDING_VALIDATION"],
      "expect": { "state": "IN_REVIEW", "code": 2 }
    }
  ]
}
